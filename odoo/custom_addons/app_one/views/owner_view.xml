<odoo>
    <record id="owner_view_tree" model="ir.ui.view">
        <field name="name">owner tree</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="address"/>
            </tree>
        </field>
    </record>
    <record id="owner_view_form" model="ir.ui.view">
        <field name="name">owner tree</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="name" string="Name" colspan="2">
                            <div class="oe_title" colspan="2">
                                <h1 colspan="2">
                                    <field name="name"/>
                                </h1>
                            </div>
                        </group>
                        <group name="details" string="Details" colspan="1">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="owner_action" model="ir.actions.act_window">
        <field name="name">Owner</field>
        <field name="res_model">owner</field>
        <field name="view_mode">tree,form</field>        <!-- Add this line -->

    </record>
    <menuitem id="owner_menu_item" name="Owners" parent="configration_menu" action="owner_action" />
</odoo>