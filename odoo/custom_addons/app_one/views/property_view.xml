<odoo>
  <record id="property_view_tree" model="ir.ui.view">
    <field name="name">property tree</field>
    <field name="model">property</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="date_availability"/>
        <field name="owner_id"/>
        <field name="tag_ids"/>
        <field name="selling_price"/>
        <field name="garden"/>
        <field name="bedrooms" optional="1"/>
        <field name="living_area" optional="1"/>
      </tree>
    </field>
  </record>
  <record id="property_view_form" model="ir.ui.view">
    <field name="name">property tree</field>
    <field name="model">property</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group name="name" string="Name" colspan="2">
              <div class="oe_title" colspan="2">
                <h1 colspan="2">
                  <field name="name"/>
                </h1>
              </div>
            </group>
            <group name="details" string="Details" colspan="1">
              <field name="description"/>
              <field name="postcode"/>
              <field name="date_availability"/>
              <field name="expected_price"/>
              <field name="selling_price"/>
              <field name="owner_id"/>
              <field name="tag_ids" widget="many2many_tags"/>
            </group>
            <group name="features" string="Features" colspan="1">
              <field name="bedrooms"/>
              <field name="living_area"/>
              <field name="garage"/>
              <field name="garden"/>
              <field name="garden_area"/>
              <field name="garden_orientation"/>
              <field name="garden_orientation"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="property_view_search" model="ir.ui.view">
    <field name="name">property search</field>
    <field name="model">property</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="postcode"/>
        <filter string="Available Properties" name="available" domain="[('date_availability', '!=', False)]"/>
        <filter string="With garden" name="is_garden" domain="[('garden', '=', True)]"/>
        <filter string="is_garden" name="is_garden" domain="[('garden', '=', True)]"/>
        <filter name="group_garden" string="Garden" context="{'group_by': 'garden'}" />
      </search>
    </field>
  </record>
  <record id="property_action" model="ir.actions.act_window">
    <field name="name">Property</field>
    <field name="res_model">property</field>
    <field name="view_mode">tree,form</field>    <!-- Add this line -->

  </record>
  <menuitem id="properties_menu_item" name="Properties" parent="properties_menu" action="property_action" />
</odoo>